# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Production: set to your Vercel URL, or leave CORS_ALLOW_HTTPS=true
CORS_ALLOW_HTTPS=true
CORS_ALLOW_VERCEL=true

# Optional TURN (recommended for friends on different networks)
# TURN_URLS=turn:your-turn-host:80,turn:your-turn-host:443
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Gemini AI (STT + condensation; summary can stay here or use Hugging Face)
GEMINI_API_KEY_VOICE=
GEMINI_API_KEY_TEXT=
GEMINI_VOICE_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
SUMMARY_EVERY_N_LINES=1

# Summary backend: gemini | huggingface
SUMMARY_BACKEND=gemini
HF_TOKEN=
# Optional HF path (unused when SUMMARY_BACKEND=gemini)
HF_SUMMARY_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_PROVIDER=groq

# --- Email delivery (pick ONE) -----------------------------------------
# Option A: Resend (recommended) — https://resend.com
# Free tier works with onboarding@resend.dev for testing, or your verified domain.
RESEND_API_KEY=
EMAIL_FROM=Meet Console <onboarding@resend.dev>

# Option B: SMTP (Gmail App Password, Outlook, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=Meet Console <you@gmail.com>
