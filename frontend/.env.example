# Leave unset in local `npm run dev` — Vite proxies /api and /socket.io.
# Production (Vercel): set this to your backend origin, e.g. https://xxx.up.railway.app
# VITE_BACKEND_URL=http://localhost:4000

# Optional TURN (overrides the public relay). Same values as backend TURN_*.
# VITE_TURN_URL=turn:your-turn-host:80
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Firebase Auth (Google / GitHub / Microsoft / Phone)
# Create a project at https://console.firebase.google.com
# Enable Authentication → Sign-in method → Google, Phone, GitHub, Microsoft
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
